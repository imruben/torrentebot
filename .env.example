# Discord bot token — get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/torrentebot

# ─── Optional ─────────────────────────────────────────────────────────────────
# Only needed for `npm run deploy` (the bot registers its slash commands on startup anyway)
# CLIENT_ID=
# GUILD_ID=

# Extra Discord user IDs (comma separated) allowed to use /cookies besides the application owner
# OWNER_ID=

# Where yt-dlp reads the YouTube cookies from (default: /app/data/cookies.txt)
# YTDLP_COOKIES_PATH=./cookies.txt

# Route yt-dlp through a proxy (a residential proxy makes YouTube work without cookies)
# YTDLP_PROXY=http://user:pass@host:port

# Set to 0 to stop the bot from updating yt-dlp on boot / daily (production only)
# YTDLP_AUTO_UPDATE=1
